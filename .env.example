# Credenciais de deploy FTP da Mentoria Remodelar (HostGator).
# Copie este arquivo pra .env e preencha. O .env NÃO vai pro git (gitignored).
#
# Crie a conta no cPanel: FTP Accounts > Add FTP Account
#   - Log In:    deploy-mentoria
#   - Domain:    mentoria.ranieresousa.com.br
#   - Directory: (deixe o padrão do subdomínio, ex: mentoria.ranieresousa.com.br)
#   - Senha forte
# O usuário final fica no formato deploy-mentoria@mentoria.ranieresousa.com.br

FTP_HOST=ftp.ranieresousa.com.br
FTP_USER=deploy-mentoria@mentoria.ranieresousa.com.br
FTP_PASS=COLE_A_SENHA_AQUI
FTP_PORT=21
